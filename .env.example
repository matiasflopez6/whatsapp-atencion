# ── Copia este archivo a .env.local para desarrollo local. NUNCA subas valores reales.
# En Railway, los secretos compartidos se cargan una vez por entorno como
# variables compartidas (shared) y se referencian desde .railway/railway.ts.

# ── Base de datos
# En Railway: referencia ${{Postgres.DATABASE_URL}} (red privada).
# En local: tu Postgres local, o DATABASE_PUBLIC_URL del entorno `development`.
DATABASE_URL=postgresql://dev:dev@localhost:5432/whatsapp

# ── Variables compartidas del entorno (shared)
# 32 bytes en base64 para AES-256-GCM:  openssl rand -base64 32
ENCRYPTION_KEY=
# 32+ bytes aleatorios:                 openssl rand -base64 32
BETTER_AUTH_SECRET=
# Agente (Anthropic) e integración de Google Calendar. Opcionales para arrancar; sin ellas el agente
# no responde y /integraciones avisa. Redirect URI de Google: ${APP_URL}/api/auth/google/callback
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcionales: magic link y reseteo de contraseña (si faltan, la UI oculta esas opciones)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# ── Servicio web
HOSTNAME=0.0.0.0
# Opcional: solo con dominio propio. Si no existe se usa https://$RAILWAY_PUBLIC_DOMAIN,
# y si tampoco, http://localhost:3000. PORT y RAILWAY_PUBLIC_DOMAIN los inyecta Railway.
APP_URL=

# ── Solo desarrollo: contraseña de los usuarios de `pnpm db:seed` (se ignora en producción)
SEED_PASSWORD=
